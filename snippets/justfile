test: rust python js kotlin swift csharp

rust:
	cd rust && cargo check --all-targets

python:
	bash python/check.sh

js:
	bash js/check.sh

kotlin:
	cd kotlin && ./gradlew build --no-daemon

csharp:
	cd csharp && dotnet build

[macos]
swift:
	cd swift && swift build

[linux]
swift:
	@echo "Swift snippets require macOS; CI compiles them on macos-latest."

[windows]
swift:
	@echo "Swift snippets require macOS; CI compiles them on macos-latest."
